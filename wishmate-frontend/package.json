{
  "name": "@wishmate-frontend/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve wishmate",
    "start:open": "nx serve wishmate --open",
    "build": "nx build wishmate --configuration=production",
    "build:dev": "nx build wishmate --configuration=development",
    "lint": "nx run-many --target=lint",
    "lint:fix": "nx run-many --target=lint --fix",
    "format": "nx format:write --all",
    "format:check": "nx format:check --all",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "graph": "nx graph",
    "reset": "nx reset",
    "report": "nx report",
    "prepare": "cd .. && husky wishmate-frontend/.husky",
    "test": "nx test wishmate --watch=false",
    "test:watch": "nx test wishmate --watch=true",
    "api:generate": "ng-openapi-gen --config ng-openapi-gen.json && prettier --write libs/api-client/src/lib/generated"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~22.1.0",
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/material": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@schematics/angular": "~22.1.0",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "ng-openapi-gen": "1.1.0",
    "nx": "23.2.1",
    "postcss": "^8.5.29",
    "prettier": "~3.6.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.11"
  }
}
